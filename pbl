def color(text: str, code: str) -> str:
    return f"{code}{text}{RESET}" if sys.stdout.isatty() else text


def heading(text: str) -> None:
    print(color(text, BOLD + CYAN))


def clear_screen() -> None:
    os.system("clear" if os.name != "nt" else "cls")


def read_key() -> str:
    """Read arrows, keypad/WASD, Enter and Quit without extra packages."""
    if os.name == "nt":
        import msvcrt
        first = msvcrt.getwch()
        if first in {"\x00", "\xe0"}:
            return {"H": "up", "P": "down", "K": "left", "M": "right"}.get(msvcrt.getwch(), "")
        return "enter" if first in {"\r", "\n"} else first.lower()
    if not sys.stdin.isatty():
        return input().strip().lower()
    import termios
    import tty
    descriptor = sys.stdin.fileno()
    previous = termios.tcgetattr(descriptor)
    try:
        tty.setraw(descriptor)
        first = sys.stdin.read(1)
        if first == "\x1b":
            sequence = sys.stdin.read(2)
            return {"[A": "up", "[B": "down", "[C": "right", "[D": "left"}.get(sequence, "escape")
        return "enter" if first in {"\r", "\n"} else first.lower()
    finally:
        termios.tcsetattr(descriptor, termios.TCSADRAIN, previous)


def arrow_choice(title: str, options: Sequence[str], selected: int = 0) -> int:
    """Reusable arrow/keypad menu for desktop terminals and Ubuntu Touch."""
    if not sys.stdin.isatty():
        return selected
    selected = max(0, min(selected, len(options) - 1))
    while True:
        clear_screen()
        heading(title)
        print(color("  ↑/↓ or W/S move   Enter/→ selects   Q goes back\n", DIM))
        for index, label in enumerate(options):
            pointer = color("  ➜ ", CYAN + BOLD) if index == selected else "    "
            print(pointer + (color(label, BOLD) if index == selected else label))
        key = read_key()
        if key in {"up", "w", "k"}:
            selected = (selected - 1) % len(options)
        elif key in {"down", "s", "j"}:
            selected = (selected + 1) % len(options)
        elif key in {"enter", "right", "d", " "}:
            return selected
        elif key in {"q", "escape", "left", "a"}:
            return -1


def load_config() -> Dict[str, Any]:
    config = dict(DEFAULT_CONFIG)
    try:
        saved = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
        if isinstance(saved, dict):
            config.update(saved)
    except FileNotFoundError:
        pass
    except (json.JSONDecodeError, OSError) as error:
        print(color(f"Warning: cannot read {CONFIG_PATH}: {error}", YELLOW), file=sys.stderr)
    return config


def save_config(config: Dict[str, Any]) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    temporary = CONFIG_PATH.with_suffix(".tmp")
    temporary.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
    temporary.replace(CONFIG_PATH)


def load_catalog() -> List[Dict[str, Any]]:
    payload = json.loads(CATALOG_PATH.read_text(encoding="utf-8"))
    return list(payload["tests"])


def find_test(test_id: str) -> Dict[str, Any]:
    for item in load_catalog():
        if item["id"] == test_id:
            return item
    raise SystemExit(f"Unknown test code: {test_id}. Run 'pbl test-codes' to see choices.")


def detect_ports() -> List[str]:
    patterns = [
        "/dev/cu.usbmodem*", "/dev/cu.usbserial*", "/dev/cu.SLAB*",
        "/dev/cu.wchusbserial*", "/dev/ttyACM*", "/dev/ttyUSB*",
    ]
    ports: List[str] = []
    for pattern_value in patterns:
        ports.extend(glob.glob(pattern_value))
    if platform.system() == "Windows":
        powershell = shutil.which("powershell") or shutil.which("pwsh")
        if powershell:
            result = subprocess.run(
                [powershell, "-NoProfile", "-Command",
                 "Get-CimInstance Win32_SerialPort | Select-Object -ExpandProperty DeviceID"],
                text=True, capture_output=True, check=False,
            )
            ports.extend(line.strip() for line in result.stdout.splitlines() if line.strip().upper().startswith("COM"))
    linux_by_id = Path("/dev/serial/by-id")
    if linux_by_id.is_dir():
        ports.extend(str(path.resolve()) for path in linux_by_id.iterdir())
    return sorted(set(ports), key=lambda value: ("usbmodem" not in value.lower(), value))


def selected_port(config: Dict[str, Any], required: bool = True) -> Optional[str]:
    configured = str(config.get("port", "auto"))
    if configured != "auto":
        return configured
    ports = detect_ports()
    if ports:
        return ports[0]
    if required:
        raise SystemExit("No serial device detected. Connect the board or run 'pbl configure'.")
    return None


def idf_path() -> Optional[Path]:
    candidates = [
        os.environ.get("IDF_PATH"),
        str(Path.home() / "esp" / "esp-idf"),
        str(Path.home() / "esp-idf"),
    ]
    for candidate in candidates:
        if candidate:
            root = Path(candidate)
            if any((root / name).is_file() for name in ("export.sh", "export.bat", "export.ps1")):
                return root.resolve()
    return None


def certificate_file() -> Optional[Path]:
    configured = os.environ.get("SSL_CERT_FILE")
    if configured and Path(configured).is_file():
        return Path(configured)
    roots = [Path.home() / "Library" / "Python", Path.home() / ".local" / "lib"]
    for root in roots:
        if root.exists():
            matches = sorted(root.glob("**/site-packages/certifi/cacert.pem"), reverse=True)
            if matches:
                return matches[0]
    return None


def shell_command(arguments: Sequence[str]) -> List[str]:
    path = idf_path()
    if path is None:
        raise SystemExit(
            "The firmware toolchain is not ready. Run 'pbl doctor' for setup guidance."
        )
    if os.name == "nt":
        export_batch = path / "export.bat"
        if not export_batch.is_file():
            raise SystemExit("ESP-IDF for Windows is incomplete: export.bat was not found.")
        command_text = f'call "{export_batch}" >nul && {subprocess.list2cmdline([str(value) for value in arguments])}'
        return ["cmd.exe", "/d", "/s", "/c", command_text]
    exports = []
    cert = certificate_file()
    if cert:
        exports.append(f"export SSL_CERT_FILE={shlex.quote(str(cert))}")
    exports.append(f"source {shlex.quote(str(path / 'export.sh'))} >/dev/null")
    command = " && ".join(exports + [shlex.join([str(value) for value in arguments])])
    return [shutil.which("bash") or "sh", "-c", command]


@contextmanager
def muted_build_keyboard():
    """Hide and discard navigation keys pressed while a tool task is active."""
    if os.name == "nt" or not sys.stdin.isatty():
        yield
        return
    import termios
    descriptor = sys.stdin.fileno()
    previous = termios.tcgetattr(descriptor)
    muted = termios.tcgetattr(descriptor)
    muted[3] &= ~termios.ECHO
    termios.tcflush(descriptor, termios.TCIFLUSH)
    termios.tcsetattr(descriptor, termios.TCSANOW, muted)
    try:
        yield
    finally:
        termios.tcflush(descriptor, termios.TCIFLUSH)
        termios.tcsetattr(descriptor, termios.TCSANOW, previous)


def run_process(arguments: Sequence[str], cwd: Path, dry_run: bool = False, task: str = "working") -> int:
    command = shell_command(arguments)
    print(color("  ➜ ", BLUE) + f"Firmware tools · {task}")
    if dry_run:
        print(color("    preview only; hardware was not changed", DIM))
        return 0
    if "monitor" in arguments:
        print(color("  ◉ Serial monitor is live · press Ctrl+] to return to PBL", GREEN))
        return subprocess.run(command, cwd=str(cwd), check=False).returncode

    # Firmware builds and uploads can take a few minutes on their first run.
    # Stream them through a small live status line instead of capture_output,
    # which previously made PBL look frozen until ESP-IDF exited.  DEVNULL also
    # prevents arrow-key escape sequences from leaking into the build shell.
    with muted_build_keyboard():
        child = subprocess.Popen(
            command,
            cwd=str(cwd),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
        )
        lines: "queue.Queue[Optional[str]]" = queue.Queue()
        tail = deque(maxlen=12)

        def read_output() -> None:
            assert child.stdout is not None
            for output_line in child.stdout:
                lines.put(output_line.rstrip())
            lines.put(None)

        threading.Thread(target=read_output, daemon=True).start()
        started = time.monotonic()
        last_line = task
        finished_output = False
        spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
        frame = 0
        try:
            while child.poll() is None or not finished_output:
                try:
                    output_line = lines.get(timeout=0.10)
                    if output_line is None:
                        finished_output = True
                    elif output_line.strip():
                        tail.append(output_line)
                        last_line = output_line.strip()
                except queue.Empty:
                    pass
                elapsed = int(time.monotonic() - started)
                summary = last_line
                if len(summary) > 76:
                    summary = summary[:73] + "..."
                if sys.stdout.isatty():
                    sys.stdout.write(
                        f"\r\033[2K  {spinner[frame % len(spinner)]} {elapsed:>3}s · {summary}"
                    )
                    sys.stdout.flush()
                elif frame % 20 == 0:
                    print(f"  ... {elapsed}s · {summary}")
                frame += 1
        except KeyboardInterrupt:
            child.terminate()
            child.wait()
            if sys.stdout.isatty():
                sys.stdout.write("\r\033[2K")
            print(color("  ! cancelled", YELLOW))
            return 130

    if sys.stdout.isatty():
        sys.stdout.write("\r\033[2K")
        sys.stdout.flush()
    returncode = child.wait()
    if returncode == 0:
        elapsed = int(time.monotonic() - started)
        print(color(f"  ✓ complete · {elapsed}s", GREEN))
        return 0
    combined = "\n".join(tail)
    if "No serial data received" in combined or "Failed to connect" in combined:
        print(color("  ! Board detected, but it did not enter upload mode.", YELLOW))
        print("    1. Hold the BOOT button.")
        print("    2. Tap RESET once, then release BOOT.")
        print("    3. Choose Upload again; PBL will detect the port automatically.")
    else:
        print(color("  ! The firmware tools could not finish this task.", RED))
        for line in list(tail)[-8:]:
            print(color("    " + line[:120], DIM))
    return returncode


def project_for(item: Dict[str, Any]) -> Path:
    project = (ROOT / item["project"]).resolve()
    if not project.is_dir():
        raise SystemExit(f"Test project is not installed: {project}")
    return project


def build_dir_for(item: Dict[str, Any]) -> Path:
    project_name = Path(item["project"]).name
    return (STATE_DIR / "build" / project_name).resolve()


def preserve_partial_build(item: Dict[str, Any]) -> None:
    build_dir = build_dir_for(item)
    if not build_dir.exists() or (build_dir / "CMakeCache.txt").is_file():
        return
    recovery = STATE_DIR / "recovered-builds"
    recovery.mkdir(parents=True, exist_ok=True)
    destination = recovery / f"{item['id']}-{int(time.time())}"
    build_dir.replace(destination)
    print(color(f"Preserved incomplete build at {destination}", YELLOW))


def idf_build_arguments(item: Dict[str, Any], config: Dict[str, Any]) -> List[str]:
    arguments = ["idf.py", "-B", str(build_dir_for(item))]
    if "mode" in item:
        arguments.extend(["-D", f"PBL_TEST_MODE={item['mode']}"])
    if not (build_dir_for(item) / "CMakeCache.txt").is_file():
        arguments.extend(["set-target", str(config["processor"])])
    arguments.append("build")
    return arguments


def compatibility(item: Dict[str, Any], config: Dict[str, Any]) -> str:
    processors = item.get("processors", [])
    boards = item.get("boards", [])
    if processors and config["processor"] not in processors:
        return "processor mismatch"
    if boards and config["board"] not in boards and "*" not in boards:
        return "board mismatch"
    return "ready"


def command_build(args: argparse.Namespace, config: Dict[str, Any]) -> int:
    item = find_test(args.test or config["selected_test"])
    state = compatibility(item, config)
    if state != "ready" and not args.force:
        raise SystemExit(f"{item['name']} is not compatible with this profile: {state}. Use --force to override.")
    if not args.dry_run:
        preserve_partial_build(item)
    heading(f"Building · {item['name']}")
    return run_process(idf_build_arguments(item, config), project_for(item), args.dry_run, "building official firmware")


def command_upload(args: argparse.Namespace, config: Dict[str, Any]) -> int:
    item = find_test(args.test or config["selected_test"])
    state = compatibility(item, config)
    if state != "ready" and not args.force:
        raise SystemExit(f"{item['name']} is not compatible with this profile: {state}. Use --force to override.")
    port = args.port or selected_port(config, required=not args.dry_run) or "<auto-detect>"
    heading(f"Uploading · {item['name']} · {port}")
    project = project_for(item)
    build_dir = build_dir_for(item)
    if not args.dry_run:
        preserve_partial_build(item)
    if not getattr(args, "skip_build", False):
        result = run_process(idf_build_arguments(item, config), project, args.dry_run, "preparing official firmware")
        if result:
            return result
    flash_arguments = ["idf.py", "-B", str(build_dir), "-p", str(port), "-b", "921600", "flash"]
    result = run_process(flash_arguments, project, args.dry_run, "uploading to the board")
    if result and not args.dry_run:
        refreshed_port = selected_port(config, required=False)
        if refreshed_port:
            print(color("  ↻ PBL is retrying the board handshake once...", YELLOW))
            time.sleep(0.8)
            flash_arguments = ["idf.py", "-B", str(build_dir), "-p", str(refreshed_port), "-b", "921600", "flash"]
            result = run_process(flash_arguments, project, False, "retrying the upload")
    if result or not item.get("model_flash"):
        return result
    model = (ROOT / item["model_flash"]["file"]).resolve()
    address = item["model_flash"]["address"]
    return run_process(
        ["esptool.py", "--chip", config["processor"], "--port", str(port), "--baud", "921600",
         "write_flash", address, str(model)],
        project,
        args.dry_run, "installing the local AI model",
    )


def command_monitor(args: argparse.Namespace, config: Dict[str, Any]) -> int:
    item = find_test(args.test or config["selected_test"])
    port = args.port or selected_port(config, required=not args.dry_run) or "<auto-detect>"
    heading(f"Monitoring · {item['name']} · {port}")
    return run_process(
        ["idf.py", "-B", str(build_dir_for(item)), "-p", str(port), "monitor"],
        project_for(item),
        args.dry_run, "opening the device console",
    )


def command_run(args: argparse.Namespace, config: Dict[str, Any]) -> int:
    item = find_test(args.test or config["selected_test"])
    if not args.yes and not args.dry_run and sys.stdin.isatty():
        print(f"PBL will replace the firmware on {selected_port(config)} with {item['name']}.")
        if input("Continue? [y/N] ").strip().lower() not in {"y", "yes"}:
            print("Cancelled; the device was not changed.")
            return 0
    result = command_build(args, config)
    if result:
        return result
    args.skip_build = True
    result = command_upload(args, config)
    if result:
        return result
    return command_monitor(args, config)


def command_ports(config: Dict[str, Any]) -> int:
    heading("Connected serial devices")
    ports = detect_ports()
    if not ports:
        print(color("No likely ESP serial ports found.", YELLOW))
        return 1
    configured = selected_port(config, required=False)
    for index, port in enumerate(ports, 1):
        selected = "  ← selected" if port == configured else ""
        print(f"  {index:>2}. {port}{color(selected, GREEN)}")
    return 0


def show_config(config: Dict[str, Any]) -> None:
    heading("Hardware profile")
    for key in ("processor", "board", "display", "input", "microphone", "speaker", "port", "selected_test"):
        print(f"  {key.replace('_', ' ').title():<16} {config[key]}")


def choose(label: str, options: Sequence[Sequence[str]], current: str) -> str:
    if sys.stdin.isatty():
        current_index = next((index for index, item in enumerate(options) if item[0] == current), 0)
        selected_index = arrow_choice(
            f"PBL Hardware · {label}",
            [f"{description}  [{value}]" for value, description in options],
            current_index,
        )
        return current if selected_index < 0 else str(options[selected_index][0])
    print(color(f"\n{label}", BOLD))
    for number, (value, description) in enumerate(options, 1):
        marker = "●" if value == current else "○"
        print(f"  {number:>2}. {marker} {description} {color('[' + value + ']', DIM)}")
    while True:
        answer = input(f"Choose 1-{len(options)} [keep current]: ").strip()
        if not answer:
            return current
        if answer.isdigit() and 1 <= int(answer) <= len(options):
            return options[int(answer) - 1][0]
        print(color("Please enter one of the displayed numbers.", YELLOW))


def command_configure(args: argparse.Namespace, config: Dict[str, Any]) -> int:
    if args.show:
        show_config(config)
        return 0
    heading("PBL Hardware Configurator")
    print("Choose the hardware you actually have. PBL uses this to hide unsafe or incompatible tests.")
    for key in ("processor", "board", "display", "input", "microphone", "speaker"):
        config[key] = choose(key.replace("_", " ").title(), CHOICES[key], str(config[key]))
    ports = detect_ports()
    port_options = [("auto", "Automatically use the first connected ESP board")]
    port_options.extend((port, port) for port in ports)
    port_options.append(("manual", "Enter a serial port manually"))
    selected = choose("Serial port", port_options, str(config.get("port", "auto")))
    if selected == "manual":
        selected = input("Serial port: ").strip() or "auto"
    config["port"] = selected
    save_config(config)
    print(color(f"\nSaved {CONFIG_PATH}", GREEN))
    show_config(config)
    return 0


def print_test_codes(config: Dict[str, Any]) -> None:
    heading("PBL test-code library")
    print(f"{'ID':<25} {'Hardware':<25} {'Status':<20} Description")
    print("─" * 110)
    for item in load_catalog():
        marker = "●" if item["id"] == config["selected_test"] else " "
        status = compatibility(item, config)
        status_color = GREEN if status == "ready" else YELLOW
        print(f"{marker} {item['id']:<23} {item['hardware']:<25} {color(status, status_color):<20} {item['description']}")


def command_select(args: argparse.Namespace, config: Dict[str, Any]) -> int:
    catalog = load_catalog()
    if args.test:
        selected = find_test(args.test)
    else:
        print_test_codes(config)
        compatible = [item for item in catalog if compatibility(item, config) == "ready"]
        print("\nCompatible choices:")
        for number, item in enumerate(compatible, 1):
            print(f"  {number:>2}. {item['name']} [{item['id']}]")
        answer = input("Select test number: ").strip()
        if not answer.isdigit() or not (1 <= int(answer) <= len(compatible)):
            raise SystemExit("No test selected.")
        selected = compatible[int(answer) - 1]
    state = compatibility(selected, config)
    if state != "ready" and not args.force:
        raise SystemExit(f"Cannot select {selected['name']}: {state}. Use --force to override.")
    config["selected_test"] = selected["id"]
    save_config(config)
    print(color(f"Selected: {selected['name']}", GREEN))
    print("Run it with: pbl run")
    return 0


def command_doctor(config: Dict[str, Any]) -> int:
    heading("PBL Doctor")
    checks = []
    checks.append(("Python", sys.version.split()[0], sys.version_info >= (3, 9)))
    path = idf_path()
    checks.append(("ESP-IDF", str(path) if path else "not found", path is not None))
    checks.append(("C compiler", shutil.which("cc") or "not found", shutil.which("cc") is not None))
    ports = detect_ports()
    checks.append(("ESP serial port", ", ".join(ports) if ports else "not found", bool(ports)))
    checks.append(("Test catalog", f"{len(load_catalog())} tests", CATALOG_PATH.is_file()))
    for name, detail, passed in checks:
        symbol = color("PASS", GREEN) if passed else color("CHECK", YELLOW)
        print(f"  {symbol:<14} {name:<18} {detail}")
    print()
    show_config(config)
    return 0 if all(passed for _, _, passed in checks[:2]) else 1


def command_install(args: argparse.Namespace) -> int:
    destination_dir = Path.home() / ".local" / "bin"
    destination = destination_dir / "pbl"
    destination_dir.mkdir(parents=True, exist_ok=True)
    already_installed = False
    if destination.exists() or destination.is_symlink():
        if destination.resolve() == Path(__file__).resolve():
            already_installed = True
        elif not args.force:
            raise SystemExit(f"{destination} already exists. Re-run with --force to replace that one link.")
        elif not destination.is_symlink():
            raise SystemExit(f"Refusing to replace regular file {destination}; move it manually first.")
        else:
            destination.unlink()
    if not already_installed:
        destination.symlink_to(Path(__file__).resolve())
    print(color(f"Installed command: {destination}", GREEN))
    installed_aliases = 0
    for alias_name in INSTALL_ALIASES:
        alias = destination_dir / alias_name
        if alias.exists() or alias.is_symlink():
            if alias.resolve() != Path(__file__).resolve():
                print(color(f"Kept existing command: {alias}", YELLOW))
            continue
        alias.symlink_to(Path(__file__).resolve())
        installed_aliases += 1
    print(f"Installed {installed_aliases} compact pbl--command aliases.")
    if str(destination_dir) not in os.environ.get("PATH", "").split(os.pathsep):
        print("Add this once to your shell profile:")
        print('  export PATH="$HOME/.local/bin:$PATH"')
    print("Then open a new terminal and run: pbl")
    return 0


def dashboard(config: Dict[str, Any]) -> int:
    menu = [
        ("▶  Run selected experience", lambda: command_run(arg_namespace(yes=False), config)),
        ("◆  Select test code", lambda: command_select(arg_namespace(test=None), config)),
        ("⚙  Configure hardware", lambda: command_configure(arg_namespace(show=False), config)),
        ("⇧  Upload selected test", lambda: command_upload(arg_namespace(), config)),
        ("◉  Serial monitor", lambda: command_monitor(arg_namespace(), config)),
        ("⌁  Detect connected board", lambda: command_ports(config)),
        ("✓  PBL Doctor", lambda: command_doctor(config)),
        ("?  Help", lambda: print_help(build_parser())),
        ("×  Quit", None),
    ]
    selected_index = 0
    while True:
        clear_screen()
        port = selected_port(config, required=False) or "not connected"
        selected = find_test(config["selected_test"])
        print(color("╭──────────────────────────────────────────────────────────────────────╮", CYAN))
        print(color("│", CYAN) + color("  PBL · PROJECTS BY LAKSH", BOLD) + "                                           " + color("│", CYAN))
        print(color("│", CYAN) + "  Build · Learn · Run local AI on real hardware                    " + color("│", CYAN))
        print(color("├──────────────────────────────────────────────────────────────────────┤", CYAN))
        print(color("│", CYAN) + f"  BOARD  {config['board'][:33]:<33} PORT  {port[-22:]:<22} " + color("│", CYAN))
        print(color("│", CYAN) + f"  TEST   {selected['name'][:54]:<54}           " + color("│", CYAN))
        print(color("├──────────────────────────────────────────────────────────────────────┤", CYAN))
        for index, (label, _) in enumerate(menu):
            pointer = color(" ➜ ", CYAN + BOLD) if index == selected_index else "   "
            padded = f"{label:<65}"
            rendered = color(padded, BOLD) if index == selected_index else padded
            print(color("│", CYAN) + pointer + rendered + color("│", CYAN))
        print(color("├──────────────────────────────────────────────────────────────────────┤", CYAN))
        print(color("│", CYAN) + "  ↑/↓ or W/S move · Enter/→ select · number shortcuts · Q quit     " + color("│", CYAN))
        print(color("╰──────────────────────────────────────────────────────────────────────╯", CYAN))
        answer = read_key()
        if answer in {"up", "w", "k"}:
            selected_index = (selected_index - 1) % len(menu)
            continue
        if answer in {"down", "s", "j"}:
            selected_index = (selected_index + 1) % len(menu)
            continue
        if answer.isdigit() and 1 <= int(answer) <= 8:
            selected_index = int(answer) - 1
            answer = "enter"
        if answer in {"q", "escape"} or (answer in {"enter", "right", "d", " "} and menu[selected_index][1] is None):
            return 0
        if answer in {"enter", "right", "d", " "}:
            action = menu[selected_index][1]
            try:
                if action:
                    action()
            except (KeyboardInterrupt, SystemExit) as error:
                print(color(str(error) or "Cancelled.", YELLOW))
            input("\nPress Enter to return to PBL...")


def arg_namespace(**values: Any) -> argparse.Namespace:
    defaults = {"test": None, "port": None, "dry_run": False, "force": False, "yes": False, "show": False}
    defaults.update(values)
    return argparse.Namespace(**defaults)


def add_test_options(parser: argparse.ArgumentParser, run: bool = False) -> None:
    parser.add_argument("test", nargs="?", help="test-code ID (defaults to selected test)")
    parser.add_argument("--port", help="serial port; overrides saved auto-detection")
    parser.add_argument("--dry-run", action="store_true", help="print commands without executing them")
    parser.add_argument("--force", action="store_true", help="override hardware-profile compatibility")
    if run:
        parser.add_argument("-y", "--yes", action="store_true", help="upload without confirmation")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="pbl", add_help=False)
    parser.add_argument("-h", "--help", action="store_true")
    parser.add_argument("--version", action="store_true")
    subparsers = parser.add_subparsers(dest="command")
    subparsers.add_parser("help", add_help=False)
    subparsers.add_parser("dashboard", add_help=False)
    subparsers.add_parser("detect-port", aliases=["ports"], add_help=False)
    subparsers.add_parser("test-codes", aliases=["tests"], add_help=False)
    subparsers.add_parser("doctor", add_help=False)
    configure = subparsers.add_parser("configure", aliases=["config"], add_help=False)
    configure.add_argument("--show", action="store_true")
    select_parser = subparsers.add_parser("select", add_help=False)
    select_parser.add_argument("test", nargs="?")
    select_parser.add_argument("--force", action="store_true")
    install_parser = subparsers.add_parser("install", add_help=False)
    install_parser.add_argument("--force", action="store_true")
    for name in ("build", "upload", "monitor"):
        child = subparsers.add_parser(name, add_help=False)
        add_test_options(child)
    run_parser = subparsers.add_parser("run", add_help=False)
    add_test_options(run_parser, run=True)
    return parser


def print_help(parser: argparse.ArgumentParser) -> None:
    heading("PBL · Projects by Laksh")
    print("One terminal for CircuitHeroesLM, hardware tests and local AI.\n")
    print("  pbl                         open the interactive dashboard")
    print("  pbl configure               choose processor, display, touch, mic and speaker")
    print("  pbl test-codes              show the hardware test-code library")
    print("  pbl select [test]           select a test firmware")
    print("  pbl detect-port             find a connected board")
    print("  pbl run [test]              build, upload and monitor")
    print("  pbl build [test]            compile only")
    print("  pbl upload [test]           upload only")
    print("  pbl monitor [test]          open serial monitor")
    print("  pbl doctor                  check firmware tools and connected hardware")
    print("  pbl install                 install the global pbl command without pip")
    print("\nOption-style forms also work: pbl --run, pbl --upload, pbl --detect-port.")
    print("Use --dry-run with build/run/upload/monitor to preview every command.")


def normalized_arguments(arguments: Sequence[str]) -> List[str]:
    values = list(arguments)
    aliases = {
        "--run": "run", "--build": "build", "--upload": "upload",
        "--monitor": "monitor", "--detect-port": "detect-port",
        "--test-codes": "test-codes", "--configure": "configure",
        "--select": "select", "--doctor": "doctor",
    }
    if values and values[0] in aliases:
        values[0] = aliases[values[0]]
    return values


def main(arguments: Optional[Sequence[str]] = None) -> int:
    raw_values = list(sys.argv[1:] if arguments is None else arguments)
    invoked_as = Path(sys.argv[0]).name
    if arguments is None and invoked_as.startswith("pbl--"):
        raw_values.insert(0, "--" + invoked_as[len("pbl--"):])
    values = normalized_arguments(raw_values)
    parser = build_parser()
    args = parser.parse_args(values)
    config = load_config()
    if args.version:
        print(f"PBL {VERSION}")
        return 0
    if args.help or args.command == "help":
        print_help(parser)
        return 0
    if args.command in (None, "dashboard"):
        if not sys.stdin.isatty():
            print_help(parser)
            return 0
        return dashboard(config)
    if args.command in {"detect-port", "ports"}:
        return command_ports(config)
    if args.command in {"test-codes", "tests"}:
        print_test_codes(config)
        return 0
    if args.command in {"configure", "config"}:
        return command_configure(args, config)
    if args.command == "select":
        return command_select(args, config)
    if args.command == "doctor":
        return command_doctor(config)
    if args.command == "install":
        return command_install(args)
    commands = {
        "build": command_build, "upload": command_upload,
        "monitor": command_monitor, "run": command_run,
    }
    return commands[args.command](args, config)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("\nCancelled.", file=sys.stderr)
        raise SystemExit(130)
